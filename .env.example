PILOT_DATABASE_URL=postgres://pilot:change-me@127.0.0.1:5432/pilot?sslmode=disable
# Leave empty to let scripts/detect-sub2api.sh copy the running Sub2API database URL.
# Never migrated by Pilot. Fill only when Sub2API is not a local Docker container.
PILOT_SUB2API_DATABASE_URL=
PILOT_SUB2API_LOG_DATABASE_URL=
# Daily audit JSONL directory; the service user must be able to create and append files here.
PILOT_LOG_DIR=./logs
# Generate with: openssl rand -base64 32
PILOT_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
PILOT_LISTEN_ADDR=127.0.0.1:33777
PILOT_PUBLIC_URL=http://127.0.0.1:33777
PILOT_COOKIE_SECURE=false
PILOT_AUTO_MIGRATE=true
PILOT_WORKERS=8
# Keep false for a multi-user Internet-facing deployment. Enable only when users
# must connect to trusted RFC1918/loopback upstreams.
PILOT_ALLOW_PRIVATE_UPSTREAMS=false
