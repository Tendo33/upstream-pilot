S2AM_DATABASE_URL=postgres://s2am:change-me@127.0.0.1:5432/s2am?sslmode=disable
# Daily audit JSONL directory; the service user must be able to create and append files here.
S2AM_LOG_DIR=./logs
# Generate with: openssl rand -base64 32
S2AM_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
S2AM_LISTEN_ADDR=:33777
S2AM_PUBLIC_URL=http://127.0.0.1:33777
S2AM_COOKIE_SECURE=false
S2AM_AUTO_MIGRATE=true
S2AM_WORKERS=8
# Keep false for a multi-user Internet-facing deployment. Enable only when users
# must connect to trusted RFC1918/loopback upstreams.
S2AM_ALLOW_PRIVATE_UPSTREAMS=false
