POSTGRES_DB=pilot
POSTGRES_USER=pilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
PILOT_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
PILOT_PUBLIC_URL=http://localhost:33777
PILOT_COOKIE_SECURE=false
PILOT_AUTO_MIGRATE=true
PILOT_WORKERS=8
PILOT_ALLOW_PRIVATE_UPSTREAMS=false
# Optional host port; defaults to 33777.
PILOT_PORT=33777
# Use the published image instead of building locally:
# PILOT_IMAGE=docker.io/simonsun3/upstream-pilot:latest

# Leave empty: install.sh / scripts/detect-sub2api.sh copy these from a running Sub2API container.
# Fill only when Sub2API is not on the same Docker host.
PILOT_SUB2API_DATABASE_URL=
PILOT_SUB2API_LOG_DATABASE_URL=
